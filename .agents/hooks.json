{
  "ds-workflow": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/lint.py",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "command": "python3 ./hooks/stop_tests.py",
        "timeout": 150
      }
    ],
    "SessionStart": [
      {
        "command": "python3 ./hooks/session_start.py",
        "timeout": 5
      }
    ]
  }
}
