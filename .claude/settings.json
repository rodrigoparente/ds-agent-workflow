{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(notebooks/*.ipynb)",
      "Edit(notebooks/*.ipynb)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 90,
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/lint.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 150,
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/stop_tests.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/session_start.py\""
          }
        ]
      }
    ]
  }
}
