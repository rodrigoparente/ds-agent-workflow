{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 .agents/tools/check_notebook.py *)",
      "Bash(python .agents/tools/check_notebook.py *)",
      "Bash(.venv/bin/python .agents/tools/check_notebook.py *)",
      "Bash(python3 .agents/tools/nb_summary.py *)",
      "Bash(python .agents/tools/nb_summary.py *)",
      "Bash(.venv/bin/python .agents/tools/nb_summary.py *)",
      "Bash(python3 .agents/tools/export_docx.py *)",
      "Bash(python .agents/tools/export_docx.py *)",
      "Bash(.venv/bin/python .agents/tools/export_docx.py *)",
      "Bash(python3 .agents/skills/research/scripts/papers.py *)",
      "Bash(python .agents/skills/research/scripts/papers.py *)",
      "Bash(python3 .agents/skills/presentation/scripts/deck.py *)",
      "Bash(python .agents/skills/presentation/scripts/deck.py *)",
      "Bash(.venv/bin/python .agents/skills/presentation/scripts/deck.py *)",
      "Bash(pytest)",
      "Bash(pytest *)",
      "Bash(.venv/bin/pytest)",
      "Bash(.venv/bin/pytest *)",
      "Bash(ruff *)",
      "Bash(.venv/bin/ruff *)",
      "Bash(nbstripout *)",
      "Bash(.venv/bin/nbstripout *)",
      "Bash(soffice *)",
      "Bash(pdftoppm *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "WebSearch",
      "WebFetch"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(pip install *)",
      "Bash(.venv/bin/pip install *)",
      "Bash(pip uninstall *)",
      "Bash(.venv/bin/pip uninstall *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(./data/**)",
      "Read(data/**)",
      "Edit(notebooks/*.ipynb)",
      "Write(notebooks/*.ipynb)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 90,
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/lint.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 150,
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/stop_tests.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/session_start.py\""
          }
        ]
      }
    ]
  }
}
